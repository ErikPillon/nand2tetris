  "side_quests": [
    {
      "id": "nand-golf",
      "title": "Hit par on all fifteen gates",
      "after": 1,
      "effort": "an evening",
      "kind": "hardware",
      "blurb": "The -m optimal suite enforces the minimal NAND count for every Project 1 chip. It is a genuine puzzle set, and it teaches the one optimisation that matters: compute a shared subexpression once.",
      "status": "idea"
    },
    {
      "id": "nor-world",
      "title": "Rebuild everything from NOR",
      "after": 1,
      "effort": "an evening",
      "kind": "theory",
      "blurb": "NOR is also functionally complete. Derive the basis from it, then ask which gates get cheaper and which get dearer -- and why CMOS prefers one.",
      "status": "idea"
    },
    {
      "id": "circuit-lower-bound",
      "title": "Prove most functions need exponentially many gates",
      "after": 1,
      "effort": "an evening",
      "kind": "theory",
      "blurb": "A counting argument: there are 2^(2^n) Boolean functions but only so many small circuits, so almost every function needs about 2^n/n gates. Shannon, 1949. Sobering, and a nice contrast with the constructive DNF bound.",
      "status": "idea"
    },
    {
      "id": "smt-verify",
      "title": "Prove the chips correct instead of testing them",
      "after": 1,
      "effort": "a weekend",
      "kind": "tooling",
      "blurb": "Bit-blast a gate and its specification into SAT and check that the difference is unsatisfiable. Exhaustive testing works at 16 bits; proof scales. Z3 via its Python bindings.",
      "status": "idea"
    },
    {
      "id": "carry-lookahead",
      "title": "An adder with logarithmic depth",
      "after": 2,
      "effort": "a weekend",
      "kind": "hardware",
      "blurb": "Ripple-carry has O(n) delay. Add a depth counter to the simulator, measure the critical path, then build a carry-lookahead adder and watch depth fall to O(log n) while gate count rises. The first real area-vs-time trade.",
      "status": "idea"
    },
    {
      "id": "barrel-shifter",
      "title": "Shift by any amount in log-depth muxes",
      "after": 2,
      "effort": "an evening",
      "kind": "hardware",
      "blurb": "Hack has no shift instruction, which is why Jack multiplication is slow. Build a 16-bit barrel shifter from four mux layers, then ask what adding a shift opcode would do to Project 12's Math.multiply.",
      "status": "idea"
    },
    {
      "id": "hardware-multiplier",
      "title": "A combinational 16x16 multiplier",
      "after": 2,
      "effort": "a weekend",
      "kind": "hardware",
      "blurb": "An array multiplier, measured in NANDs. Then compare against the software Math.multiply you will write in Project 12 and decide which the Hack designers should have chosen.",
      "status": "idea"
    },
    {
      "id": "minifloat",
      "title": "IEEE-754 addition, in miniature",
      "after": 2,
      "effort": "a project",
      "kind": "hardware",
      "blurb": "An 8- or 16-bit float adder: unpack, align exponents, add, renormalise, round to nearest even. Brutal, and the fastest way to understand why floating point surprises people.",
      "status": "idea"
    },
    {
      "id": "event-driven-sim",
      "title": "Simulate time properly",
      "after": 3,
      "effort": "a weekend",
      "kind": "tooling",
      "blurb": "Replace function composition with an event queue and per-gate propagation delay. Then build a flip-flop out of two NANDs and watch it go metastable -- the thing the clean abstraction hides from you.",
      "status": "idea"
    },
    {
      "id": "prove-the-pc",
      "title": "Verify the program counter by induction",
      "after": 3,
      "effort": "an evening",
      "kind": "theory",
      "blurb": "The PC is the first chip with a nontrivial temporal specification. State it as an invariant over clock cycles and prove it, rather than sampling 200 cycles.",
      "status": "idea"
    },
    {
      "id": "rust-emulator",
      "title": "Port the emulator to Rust",
      "after": 5,
      "effort": "a project",
      "kind": "languages",
      "blurb": "The gate-level Computer is too slow to play Pong. Write the behavioural emulator in Rust and differential-test it against the Python one. Tight integer loops, no allocation, a reference implementation to check against: a well-scoped first Rust project.",
      "status": "idea"
    },
    {
      "id": "verilog-fpga",
      "title": "Put your CPU on real silicon",
      "after": 5,
      "effort": "a project",
      "kind": "hardware",
      "blurb": "Rewrite the CPU in Verilog, synthesise with Yosys and nextpnr, and run it on a forty-euro iCE40 board. The moment the abstraction stops being a metaphor.",
      "status": "idea"
    },
    {
      "id": "cache",
      "title": "Add a cache and measure it",
      "after": 5,
      "effort": "a weekend",
      "kind": "systems",
      "blurb": "Direct-mapped first, then two-way set-associative. Instrument hit rate on real programs. Memory hierarchy is the one major architectural idea nand2tetris leaves out entirely.",
      "status": "idea"
    },
    {
      "id": "pipeline",
      "title": "Pipeline the CPU, then fix the hazards",
      "after": 5,
      "effort": "a project",
      "kind": "hardware",
      "blurb": "Split fetch and execute into two stages, discover data and control hazards, then stall and forward your way out of them. This is most of a first graduate architecture course.",
      "status": "idea"
    },
    {
      "id": "turing-complete",
      "title": "Prove the Hack machine is Turing-complete",
      "after": 5,
      "effort": "an evening",
      "kind": "theory",
      "blurb": "Modulo its finite memory. Simulate a two-counter machine, or reduce from a known universal model. Makes precise what 'general-purpose computer' actually claims.",
      "status": "idea"
